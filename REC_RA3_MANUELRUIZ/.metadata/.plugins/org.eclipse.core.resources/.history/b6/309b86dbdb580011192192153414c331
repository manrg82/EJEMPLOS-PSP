package servidor;

import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.net.Socket;
import java.util.ArrayList;

import comun.Peticion;
import comun.Respuesta;

public class HiloComida implements Runnable{
	private Socket sc;
	public HiloComida(Socket s) {
		this.sc=s;
	}
	@Override
	public void run() {
		try(
			ObjectOutputStream out=new ObjectOutputStream(sc.getOutputStream());
			ObjectInputStream inp=new ObjectInputStream(sc.getInputStream());
		){
			Peticion request=(Peticion)inp.readObject();
			if(request.getTipo().equals("NOMBRES_PLATOS_DISPONIBLES")) {//en caso de que el usuario pida la lista de platos
				
				String lsCom=ServidorComida.getLista();
				String[]ls2=lsCom.split(";");
				ArrayList<String> listaplatosdisp=new ArrayList<String>();
				for(int i=0;i<ls2.length;i++) {
					if(i%2==0) {{
						if(Integer.parseInt(ls2[i+1])>0) {
							listaplatosdisp.add(ls2[i]);
						}
					}
				}
				out.writeObject(new Respuesta("NOMBRES_PLATOS_DISPONIBLES",0,true,listaplatosdisp,""));
				out.flush();
			}else if(request.getTipo().equals("UNIDADES_PLATO")) {
				int cantidad=ServidorComida.getCantidadPlato(request.getComida());
				out.writeObject(new Respuesta("UNIDADES_PLATO",cantidad,true,null,request.getComida()));
				out.flush();
			}else {
				return;
			}
		} catch (ClassNotFoundException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		
		
	}

}
